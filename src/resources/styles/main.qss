/*
References:
https://doc.qt.io/qt-6/stylesheet-syntax.html
https://doc.qt.io/qt-6/stylesheet-reference.html
https://doc.qt.io/qt-6/stylesheet-examples.html
*/

/* Menubar */

QMenuBar {
  background-color: transparent;
}

/* Toolbar */

QMainWindow > QToolBar {
  border-bottom-width: 1px;
  border-bottom-style: solid;
  padding: 8px;
}

QMainWindow > QToolBar QLineEdit {
  padding: 4px 8px;
}

QToolButton::menu-indicator {
  width: 0px;
}

/* List tabs */

QTabBar QLabel#tabCounter {
  background-color: rgba(128, 128, 128, 22%);
  border-radius: 8px;
  color: palette(placeholder-text);
  margin-left: 6px;
  padding: 0px 6px;
}

/* Navigation */

QTreeWidget#navigation {
  background-color: transparent;
  outline: none;
  padding: 16px 8px;
}

QTreeWidget#navigation::item {
  background-color: transparent;
  border-radius: 3px;
  padding-left: 4px;
  padding-right: 4px;
}

/* List */

QStackedWidget QListView,
QStackedWidget QTreeView {
  border-top-width: 1px;
  border-top-style: solid;
}

QTreeView#animeList QHeaderView {
  border-bottom-width: 1px;
  border-bottom-style: solid;
}

QTreeView#animeList QHeaderView::section,
QTreeView#historyView QHeaderView::section,
QTreeView#libraryView QHeaderView::section {
  font-weight: 600;
  padding-top: 5px;
  padding-bottom: 5px;
  padding-left: 12px;
  padding-right: 12px;
}

QTreeView#animeList,
QTreeView#historyView,
QTreeView#libraryView {
  selection-background-color: transparent;
}

QTreeView#animeList::item,
QTreeView#historyView::item,
QTreeView#libraryView::item {
  padding-left: 8px;
  padding-right: 8px;
}

QTreeView#historyView::item,
QTreeView#libraryView::item {
  min-height: 24px;
}

/* The padding also widens the name column, which fits its contents, so values keep apart */
QTreeWidget#advancedSettings::item {
  min-height: 24px;
  padding-left: 8px;
  padding-right: 8px;
}

QTreeWidget#advancedSettings QHeaderView::section {
  padding-left: 11px;
  padding-right: 11px;
}

/* Now Playing */

#nowPlaying {
  border-top-width: 1px;
  border-top-style: solid;
}

/* Statusbar */

QStatusBar#statusbar {
  border-top-width: 1px;
  border-top-style: solid;
  min-height: 32px;
}
