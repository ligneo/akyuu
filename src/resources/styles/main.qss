/*
References:
https://doc.qt.io/qt-6/stylesheet-syntax.html
https://doc.qt.io/qt-6/stylesheet-reference.html
https://doc.qt.io/qt-6/stylesheet-examples.html
*/

/* Menubar */

QMenuBar {
  background-color: transparent;
}

/* Toolbar */

QMainWindow > QToolBar {
  border-bottom-width: 1px;
  border-bottom-style: solid;
  padding: 8px;
}

QMainWindow > QToolBar QLineEdit {
  background-color: palette(base);
  border: 1px solid palette(mid);
  border-radius: 6px;
  padding: 4px 8px;
}

QMainWindow > QToolBar QLineEdit:focus {
  border-color: palette(highlight);
}

QToolButton::menu-indicator {
  width: 0px;
}

/* List tabs */

QTabBar QLabel#tabCounter {
  background-color: rgba(128, 128, 128, 22%);
  border-radius: 8px;
  color: palette(placeholder-text);
  margin-left: 6px;
  padding: 0px 6px;
}

/* Navigation */

QTreeWidget#navigation {
  background-color: transparent;
  outline: none;
  padding: 16px 8px;
}

QTreeWidget#navigation::item {
  background-color: transparent;
  border-radius: 3px;
  padding-left: 4px;
  padding-right: 4px;
}

/* List */

QStackedWidget QListView,
QStackedWidget QTreeView {
  border-top-width: 1px;
  border-top-style: solid;
}

QTreeView#animeList QHeaderView {
  border-bottom-width: 1px;
  border-bottom-style: solid;
}

QTreeView#animeList QHeaderView::section,
QTreeView#historyView QHeaderView::section,
QTreeView#libraryView QHeaderView::section {
  font-weight: 600;
  padding-top: 5px;
  padding-bottom: 5px;
  padding-left: 12px;
  padding-right: 12px;
}

QTreeView#animeList,
QTreeView#historyView,
QTreeView#libraryView {
  selection-background-color: transparent;
}

QTreeView#animeList::item,
QTreeView#historyView::item,
QTreeView#libraryView::item {
  padding-left: 8px;
  padding-right: 8px;
}

QTreeView#historyView::item,
QTreeView#libraryView::item {
  min-height: 24px;
}

/* The padding also widens the name column, which fits its contents, so values keep apart */
QTreeWidget#advancedSettings::item {
  min-height: 24px;
  padding-left: 8px;
  padding-right: 8px;
}

QTreeWidget#advancedSettings QHeaderView::section {
  padding-left: 11px;
  padding-right: 11px;
}

/* Now Playing */

#nowPlaying {
  border-top-width: 1px;
  border-top-style: solid;
}

/* Statusbar */

QStatusBar#statusbar {
  border-top-width: 1px;
  border-top-style: solid;
  min-height: 32px;
}

/* Profile */

QFrame#profileTile {
  background: rgba(128, 128, 128, 12%);
  border-radius: 8px;
}

QLabel#profileCaption {
  color: palette(placeholder-text);
}

/* Group boxes */

/* A title over a thin line rather than a box around the group, which made the pages and dialogs
   look like forms */
QGroupBox {
  border: none;
  border-top: 1px solid rgba(128, 128, 128, 30%);
  margin-top: 1.4em;
  padding-top: 10px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 0px;
  padding: 0px;
}
