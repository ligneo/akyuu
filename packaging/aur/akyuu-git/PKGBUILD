# Maintainer: cenky <cenkkgl@gmail.com>

pkgname=akyuu-git
_pkgname=akyuu
pkgver=0.1.1.r2.gdf445262
pkgrel=1
pkgdesc="Anime list tracker with media player and web browser detection (development version)"
arch=('x86_64')
url="https://github.com/ligneo/akyuu"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-multimedia' 'qt6-svg' 'systemd-libs' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'git' 'qt6-tools')
provides=("$_pkgname")
conflicts=("$_pkgname")
_submodules=(anime-relations anisthesia anitomy nstd semaver utf8proc)
source=("$_pkgname::git+https://github.com/ligneo/akyuu.git#branch=development"
        "$_pkgname-anime-relations::git+https://github.com/erengy/anime-relations.git"
        "$_pkgname-anisthesia::git+https://github.com/ligneo/anisthesia.git"
        "$_pkgname-anitomy::git+https://github.com/ligneo/anitomy.git"
        "$_pkgname-nstd::git+https://github.com/erengy/nstd.git"
        "$_pkgname-semaver::git+https://github.com/erengy/semaver.git"
        "$_pkgname-utf8proc::git+https://github.com/JuliaStrings/utf8proc.git")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

pkgver() {
	cd "$_pkgname"
	# The version comes from config.h rather than from tags: the history also holds Taiga's tags
	# (v1.4.1 and older), which `git describe` would pick up. 0.1.0-alpha, 12 commits after the
	# last version change -> 0.1.0alpha.r12.gabcdef12
	local _config=src/akyuu/config.h
	local _version _pre _base
	_version=$(sed -nE 's/^#define AKYUU_VERSION_(MAJOR|MINOR|PATCH) +([0-9]+)$/\2/p' "$_config" | paste -sd.)
	_pre=$(sed -nE 's/^#define AKYUU_VERSION_PRE +"(.*)"$/\1/p' "$_config")
	_base=$(git log -1 --format=%H -G'^#define AKYUU_VERSION_' -- "$_config")
	printf "%s%s.r%s.g%s" "$_version" "${_pre//[-.]/}" \
		"$(git rev-list --count "$_base"..HEAD)" "$(git rev-parse --short=8 HEAD)"
}

prepare() {
	cd "$_pkgname"
	# Each submodule comes from its own source above, so makepkg can cache and verify it
	local _submodule
	for _submodule in "${_submodules[@]}"; do
		git submodule init "deps/$_submodule"
		git config "submodule.$_submodule.url" "$srcdir/$_pkgname-$_submodule"
		git -c protocol.file.allow=always submodule update "deps/$_submodule"
	done
}

build() {
	cd "$_pkgname"
	# Qt keeps __FILE__ in the log context, so without this the build directory ends up inside
	# the binary and makepkg reports "Package contains reference to $srcdir".
	export CXXFLAGS="$CXXFLAGS -ffile-prefix-map=$srcdir/$_pkgname=."

	cmake -S . -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DAKYUU_PORTABLE=OFF
	cmake --build build
}

package() {
	cd "$_pkgname"
	DESTDIR="$pkgdir" cmake --install build
}
